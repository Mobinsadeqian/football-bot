# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:AAH-your-bot-token-here

# Optional: Channel username or ID to auto-post (e.g., @myfootballchannel or -1001234567890)
# If empty, only subscribers who /start will receive daily messages
CHANNEL_ID=

# Optional: football-data.org token (free tier) for alternative source
# Get from https://www.football-data.org/
FOOTBALL_DATA_TOKEN=

# File to store subscribers
SUBSCRIBERS_FILE=subscribers.json

# Show all leagues (including NCAA college etc.)? true/false
SHOW_ALL_LEAGUES=false
